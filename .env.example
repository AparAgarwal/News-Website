# Environment Variables Template

# NewsData.io API Key
# Get your free API key from: https://newsdata.io/
# Sign up and copy your API key
NEWS_API_KEY=your_newsdata_api_key_here

# IMPORTANT: 
# 1. Never commit your actual API key to the repository
# 2. When deploying to Vercel, set this as an environment variable in the Vercel dashboard
# 3. Go to Project Settings → Environment Variables → Add NEWS_API_KEY
# 4. The API key should only exist in Vercel environment variables, never in code

# Example format (don't use this, get your own):
# NEWS_API_KEY=pub_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
